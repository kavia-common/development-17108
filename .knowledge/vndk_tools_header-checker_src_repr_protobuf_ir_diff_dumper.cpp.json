ed or removed.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddLoneFunctionDiffIR(const FunctionIR * function_ir,DiffKind diff_kind)", "description": "Adds a function diff that is unreferenced and either added or removed.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddLoneEnumTypeDiffIR(const EnumTypeIR * enum_type_ir,DiffKind diff_kind)", "description": "Adds an enum type diff that is unreferenced and either added or removed.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddLoneGlobalVarDiffIR(const GlobalVarIR * global_var_ir,DiffKind diff_kind)", "description": "Adds a global variable diff that is unreferenced and either added or removed.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddRecordTypeDiffIR(const RecordTypeDiffIR * record_diff_ir,const std::string & type_stack,DiffKind diff_kind)", "description": "Adds a referenced record type diff, with information about whether it's an extension, and sets its type stack.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddFunctionDiffIR(const FunctionDiffIR * function_diff_ir,const std::string & type_stack,DiffKind diff_kind)", "description": "Adds a function diff, indicating whether it is an extension.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddEnumTypeDiffIR(const EnumTypeDiffIR * enum_diff_ir,const std::string & type_stack,DiffKind diff_kind)", "description": "Adds an enum type diff, with extension information and type stack.", "scope": "header_checker::repr::ProtobufIRDiffDumper", "scopeKind": "class"}, {"name": "bool AddGlobalVarDiffIR(const GlobalVarDiffIR * global_var_diff_ir,const std::string & type_stack,DiffKind diff_kind)", "description": "Adds a global variable diff.", "scope": "header_checker::repr::Protobuf